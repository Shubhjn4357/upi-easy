# Database URL (PostgreSQL for Production / Neon, or ./upieasy.db for local SQLite)
DATABASE_URL=postgresql://user:password@ep-name.region.aws.neon.tech/neondb?sslmode=require

# Server Environment & Port
NODE_ENV=development
PORT=8080

# Cryptographic Keys (256-bit)
JWT_SECRET=super-secret-jwt-key-for-upi-easy-auth-2026
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
REFRESH_SECRET=super-secret-refresh-key-for-upi-easy-auth-2026

# Payment Gateway Webhook HMAC Secret
WEBHOOK_SECRET=default-webhook-secret-key-for-testing

# Google OAuth 2.0 Web Client ID
GOOGLE_WEB_CLIENT_ID=332345540842-ks8bq4csr4lklkvv3tesgkig2b221m23.apps.googleusercontent.com
